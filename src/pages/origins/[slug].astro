---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { chapters } from '../../data/origins.js';

export function getStaticPaths() {
	return chapters.map((chapter) => ({ params: { slug: chapter.slug }, props: { chapter } }));
}

const { chapter } = Astro.props;
const chapterIndex = chapters.findIndex((entry) => entry.slug === chapter.slug);
const previous = chapters[chapterIndex - 1];
const next = chapters[chapterIndex + 1];
const progress = ((chapterIndex + 1) / chapters.length) * 100;
---

<SiteLayout title={`${chapter.shortTitle} — Cosmic origins`} description={chapter.teaser}>
	<section class="chapter-hero" style={`--chapter-image: url(https://images.unsplash.com/${chapter.image}?auto=format&fit=crop&w=2400&q=85)`}>
		<div class="chapter-shade"></div>
		<div class="chapter-hero-copy">
			<a class="back-link" href="/origins"><span aria-hidden="true">←</span> THE ORIGINS JOURNEY</a>
			<p class="chapter-epoch">{chapter.epoch}</p>
			<h1>{chapter.title}<br /><em>{chapter.accent}</em></h1>
			<p class="chapter-lede">{chapter.teaser}</p>
		</div>
		<div class="chapter-hero-meta"><span>{chapter.number} / 04</span><span>{chapter.imageAlt.toUpperCase()}</span></div>
	</section>

	<section class="chapter-reading">
		<aside class="chapter-rail">
			<p class="rail-title">A JOURNEY IN FOUR MOMENTS</p>
			<div class="rail-progress" role="img" aria-label={`Chapter ${chapterIndex + 1} of ${chapters.length}`} style={`--progress: ${progress}%`}><span></span></div>
			<nav aria-label="Chapters in the origins journey">
				{chapters.map((entry) => (
					<a class:list={{ current: entry.slug === chapter.slug }} href={`/origins/${entry.slug}`} aria-current={entry.slug === chapter.slug ? 'page' : undefined}>
						<span>{entry.number}</span>{entry.shortTitle}
					</a>
				))}
			</nav>
		</aside>

		<article class="chapter-article">
			<div class="chapter-fact"><span class="fact-label">A MOMENT IN TIME</span><strong>{chapter.fact}</strong><span>{chapter.factLabel}</span></div>
			{chapter.sections.map((section) => (
				<section class="story-section">
					<h2>{section.heading}</h2>
					{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</section>
			))}
			<aside class="wonder-note">
				<span class="wonder-symbol" aria-hidden="true">✳</span>
				<p>{chapter.wonder}</p>
			</aside>
			<details class="open-question">
				<summary><span>THE OPEN QUESTION</span><span class="question-toggle" aria-hidden="true">+</span></summary>
				<p>{chapter.question}</p>
			</details>
		</article>
	</section>

	<nav class="chapter-pagination" aria-label="Move through the origins journey">
		{previous ? (
			<a class="page-step previous-step" href={`/origins/${previous.slug}`}><span>← PREVIOUS MOMENT</span><strong>{previous.shortTitle}</strong></a>
		) : <span class="page-step pagination-spacer"></span>}
		<a class="journey-index-link" href="/origins" aria-label="Return to the origins timeline"><span aria-hidden="true">✳</span><span>ALL FOUR MOMENTS</span></a>
		{next ? (
			<a class="page-step next-step" href={`/origins/${next.slug}`}><span>NEXT MOMENT →</span><strong>{next.shortTitle}</strong></a>
		) : <a class="page-step next-step" href="/" ><span>RETURN TO THE ATLAS →</span><strong>Worlds worth wandering</strong></a>}
	</nav>
</SiteLayout>

<style>
	.chapter-hero { position: relative; isolation: isolate; display: flex; min-height: min(660px, calc(100svh - 70px)); align-items: center; overflow: hidden; background: #151a18 var(--chapter-image) center 48% / cover no-repeat; }
	.chapter-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgb(12 16 14 / 86%) 0%, rgb(12 16 14 / 46%) 55%, rgb(12 16 14 / 8%) 100%), linear-gradient(0deg, #101311 0%, transparent 30%, rgb(10 14 12 / 25%) 100%); }
	.chapter-hero-copy { width: min(1200px, 100%); margin: auto; padding: 72px 8vw 105px; animation: arrive 800ms both; }
	.back-link { display: inline-flex; align-items: center; gap: 10px; color: #d2d8d1; font: 500 9px/1 var(--font-sans); letter-spacing: 1.4px; text-decoration: none; }
	.back-link span { color: var(--lime); font-size: 16px; transition: transform 180ms ease; }
	.back-link:hover span { transform: translateX(-3px); }
	.chapter-epoch { margin: 58px 0 14px; color: var(--lime); font: 500 9px/1.4 var(--font-sans); letter-spacing: 1.8px; }
	h1, h2, p { margin-top: 0; }
	h1 { max-width: 820px; margin-bottom: 20px; color: var(--paper); font: 400 clamp(54px, 7vw, 90px)/.96 var(--font-serif); }
	h1 em { color: var(--lime); font-weight: 400; }
	.chapter-lede { max-width: 440px; margin-bottom: 0; color: #c2c8c1; font: 300 13px/1.8 var(--font-sans); }
	.chapter-hero-meta { position: absolute; right: 8vw; bottom: 31px; left: 8vw; display: flex; justify-content: space-between; gap: 18px; color: #c2c8c1; font: 500 8px/1.3 var(--font-sans); letter-spacing: 1.4px; }
	.chapter-hero-meta span:first-child { color: var(--lime); }
	.chapter-reading { display: grid; grid-template-columns: minmax(170px, 1fr) minmax(0, 2.3fr); gap: 8vw; max-width: 1200px; margin: auto; padding: 100px 8vw 110px; }
	.chapter-rail { align-self: start; position: sticky; top: 34px; }
	.rail-title { margin-bottom: 13px; color: #9ba59b; font: 500 8px/1.5 var(--font-sans); letter-spacing: 1.2px; }
	.rail-progress { height: 1px; margin-bottom: 19px; background: #343a34; }
	.rail-progress span { display: block; width: var(--progress); height: 1px; background: var(--lime); }
	.chapter-rail nav { display: grid; gap: 14px; }
	.chapter-rail nav a { display: flex; gap: 10px; color: #899389; font: 300 10px/1.4 var(--font-sans); text-decoration: none; transition: color 160ms ease; }
	.chapter-rail nav a span { color: #677168; font: 500 8px/1.6 var(--font-sans); }
	.chapter-rail nav a:hover, .chapter-rail nav a.current { color: var(--paper); }
	.chapter-rail nav a.current span { color: var(--lime); }
	.chapter-article { max-width: 690px; }
	.chapter-fact { display: grid; grid-template-columns: 1fr auto; gap: 7px 20px; align-items: end; margin-bottom: 53px; padding-bottom: 22px; border-bottom: 1px solid #454c45; }
	.fact-label { grid-column: 1 / -1; color: #9ba59b; font: 500 8px/1 var(--font-sans); letter-spacing: 1.5px; }
	.chapter-fact strong { color: var(--lime); font: 400 25px/1.15 var(--font-serif); }
	.chapter-fact > span:last-child { max-width: 230px; color: #a4ada5; font: 300 10px/1.7 var(--font-sans); text-align: right; }
	.story-section { margin-bottom: 42px; }
	.story-section h2 { margin-bottom: 17px; color: var(--paper); font: 400 31px/1.15 var(--font-serif); }
	.story-section p { margin-bottom: 15px; color: #b1bab2; font: 300 13px/1.9 var(--font-sans); }
	.wonder-note { display: grid; grid-template-columns: 22px 1fr; gap: 14px; margin: 52px 0 35px; padding: 24px 0; border-top: 1px solid #454c45; border-bottom: 1px solid #454c45; }
	.wonder-symbol { color: var(--lime); font-size: 17px; }
	.wonder-note p { margin: 0; color: var(--paper); font: 400 18px/1.55 var(--font-serif); }
	.open-question { border-bottom: 1px solid #343a34; }
	.open-question summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 17px 0; color: #9ba59b; cursor: pointer; font: 500 8px/1 var(--font-sans); letter-spacing: 1.5px; list-style: none; }
	.open-question summary::-webkit-details-marker { display: none; }
	.question-toggle { color: var(--lime); font-size: 17px; transition: transform 180ms ease; }
	.open-question[open] .question-toggle { transform: rotate(45deg); }
	.open-question > p { max-width: 590px; margin: 0; padding: 0 0 20px; color: #aeb7ae; font: 300 12px/1.8 var(--font-sans); }
	.chapter-pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; padding: 31px 8vw; border-top: 1px solid #343a34; background: #151a17; }
	.page-step { display: grid; gap: 7px; color: var(--paper); text-decoration: none; }
	.page-step span { color: #9ba59b; font: 500 8px/1 var(--font-sans); letter-spacing: 1.1px; }
	.page-step strong { font: 400 16px/1.2 var(--font-serif); }
	.next-step { justify-items: end; text-align: right; }
	.page-step:hover strong { color: var(--lime); }
	.journey-index-link { display: grid; justify-items: center; gap: 6px; color: #9ba59b; font: 500 7px/1 var(--font-sans); letter-spacing: 1px; text-decoration: none; }
	.journey-index-link span:first-child { color: var(--lime); font-size: 15px; }
	.journey-index-link:hover { color: var(--paper); }
	@keyframes arrive { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
	@media (max-width: 680px) {
		.chapter-hero { min-height: min(680px, calc(100svh - 62px)); align-items: flex-start; background-position: 60% center; }
		.chapter-shade { background: linear-gradient(90deg, rgb(12 16 14 / 78%), rgb(12 16 14 / 26%)), linear-gradient(0deg, #101311 0%, transparent 30%, rgb(10 14 12 / 25%) 100%); }
		.chapter-hero-copy { padding: 48px 7vw 100px; }
		.chapter-epoch { margin-top: 68px; }
		h1 { font-size: clamp(54px, 12vw, 75px); }
		.chapter-hero-meta { right: 7vw; bottom: 26px; left: 7vw; font-size: 7px; }
		.chapter-hero-meta span:last-child { max-width: 54%; text-align: right; }
		.chapter-reading { grid-template-columns: 1fr; gap: 33px; padding: 68px 7vw 82px; }
		.chapter-rail { position: static; }
		.chapter-rail nav { grid-template-columns: repeat(2, 1fr); gap: 12px 15px; }
		.chapter-rail nav a { font-size: 9px; }
		.chapter-fact { grid-template-columns: 1fr; gap: 8px; margin-bottom: 42px; }
		.fact-label { grid-column: auto; }
		.chapter-fact > span:last-child { max-width: 300px; text-align: left; }
		.story-section h2 { font-size: 28px; }
		.chapter-pagination { grid-template-columns: 1fr 1fr; gap: 23px 10px; padding: 26px 7vw; }
		.journey-index-link { grid-column: 1 / -1; grid-row: 1; }
		.page-step strong { font-size: 14px; }
	}
</style>