---
import '../styles/global.css';

const { title = 'Farther — journeys beyond Earth', description = 'A field guide to extraordinary journeys across the universe.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#101311" />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Farther home"><span class="wordmark-mark">✳</span> FARTHER<span class="wordmark-period">.</span></a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="/" class:list={{ active: Astro.url.pathname === '/' }}>The atlas</a>
				<a href="/origins" class:list={{ active: Astro.url.pathname.startsWith('/origins') }}>Origins</a>
				<a href="/about" class:list={{ active: Astro.url.pathname === '/about' }}>Our story</a>
			</nav>
			<a class="header-link" href="/origins" aria-label="Begin the origins journey"><span class="header-link-label">Start at the beginning</span><span aria-hidden="true">↗</span></a>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<a class="wordmark" href="/" aria-label="Farther home"><span class="wordmark-mark">✳</span> FARTHER<span class="wordmark-period">.</span></a>
			<p>A little perspective, from a long way away.</p>
			<span>EST. SOMEWHERE IN THE MILKY WAY · 2186</span>
		</footer>
	</body>
</html>